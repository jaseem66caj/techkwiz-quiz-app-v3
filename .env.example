# ========================================
# TECHKWIZ-V8 ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to .env.local and update with your actual values

# ========================================
# APPLICATION CONFIGURATION
# ========================================

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_APP_DOMAIN=localhost

# Application Metadata
NEXT_PUBLIC_APP_NAME=TechKwiz
NEXT_PUBLIC_APP_VERSION=8.0.0

# Development Configuration
NODE_ENV=development
DISABLE_HOT_RELOAD=false

# ========================================
# ADMIN PANEL CONFIGURATION
# ========================================

# Admin Authentication
# NEXT_PUBLIC_ prefixed vars are bundled into the client and are never
# safe for secrets - admin auth must use a server-side-only env var.
# ADMIN_PASSWORD_HASH=replace-with-a-server-side-secret

# ========================================
# ANALYTICS CONFIGURATION
# ========================================

# Google Analytics 4 — official Play property (loaded in the root layout)
# Override only if you need a different Play stream. Do not point this at the
# techkwiz.com blog property (G-PLE9369CJM); that would mix KPIs.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-22M0WCZK9K

# Legacy env name kept for compatibility. It is not used by the Play GA4 tag.
# On Vercel this currently still holds the blog stream; leave it unless Jaseem
# asks to change it.
NEXT_PUBLIC_ANALYTICS_ID=G-XXXXXXXXXX

# Google Tag Manager (Optional)
# Get your Container ID from Google Tag Manager
# Format: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Enable/Disable Analytics
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ========================================
# MONETIZATION CONFIGURATION
# ========================================

# Google AdSense
# Get your Publisher ID from Google AdSense dashboard
# Format: ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-your-publisher-id

# Enable/Disable AdSense
NEXT_PUBLIC_ENABLE_ADSENSE=false

# ========================================
# DEVELOPMENT CONFIGURATION
# ========================================

# Development Server
PORT=3002

# Test Pages (only in development)
NEXT_PUBLIC_ENABLE_TEST_PAGES=true

# ========================================
# ERROR MONITORING & LOGGING
# ========================================

# Sentry Configuration
# Get your DSN from https://sentry.io/settings/projects/
# Format: https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxxxx.ingest.sentry.io/xxxxxxx
NEXT_PUBLIC_SENTRY_DSN=

# Sentry Organization and Project (for releases)
SENTRY_ORG=
SENTRY_PROJECT=

# Auth Token for Sentry CLI (for source maps upload)
SENTRY_AUTH_TOKEN=

# ========================================
# FEATURE FLAGS
# ========================================

NEXT_PUBLIC_ENABLE_ERROR_TRACKING=true
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
NEXT_PUBLIC_ENABLE_ADMIN_PANEL=true

# ========================================
# SETUP INSTRUCTIONS
# ========================================
#
# DEVELOPMENT SETUP:
# 1. Copy this file to .env
# 2. Set a server-side-only admin password/secret if needed
# 3. Run: npm run dev
# 4. Access quiz: http://localhost:3001
#
# PRODUCTION SETUP:
# 1. Update all placeholder values
# 2. Set analytics/adsense IDs
# 3. Enable analytics and adsense
# 4. Configure GitHub Secrets
# 5. Deploy via GitHub Actions
#
# ADMIN PANEL FEATURES:
# - Dashboard: Statistics and quick actions
# - Quiz Management: Add/edit/delete questions
# - Reward Configuration: Popup and coin settings
# - Analytics & Integrations: GA4, GTM, AdSense
# - System Settings: App configuration
#
# GITHUB SECRETS FOR DEPLOYMENT:
# - ADMIN_PASSWORD: replace-with-a-server-side-secret
# - ANALYTICS_ID: G-XXXXXXXXXX
# - ADSENSE_PUBLISHER_ID: ca-pub-xxxxxxxxxxxxxxxx
# - APP_URL: https://your-domain.com
# - APP_DOMAIN: your-domain.com
# - FTP_HOST, FTP_USERNAME, FTP_PASSWORD
